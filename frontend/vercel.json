{
  "framework": null,
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npx vite build",
  "outputDirectory": "dist/public",
  "env": {
    "VITE_FRONTEND_FORGE_API_URL": "https://ai-booking-os-backend.onrender.com"
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
